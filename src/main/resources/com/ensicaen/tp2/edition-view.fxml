<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<SplitPane dividerPositions="0.5" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ensicaen.tp2.EditionZoneController">

   <items>

      <!-- LEFT: HTML source code -->
      <VBox minWidth="100">

         <Label text="Code source" />

         <TextArea fx:id="htmlEditor"  style="-fx-font-family: monospace;                        -fx-font-size: 13px;" wrapText="false" VBox.vgrow="ALWAYS" />

      </VBox>

      <!-- RIGHT: HTML preview -->
      <VBox minWidth="100">

         <Label text="Aperçu" />

         <WebView fx:id="htmlPreview" VBox.vgrow="ALWAYS" />

      </VBox>

   </items>

</SplitPane>
